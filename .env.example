# ─────────────────────────────────────────────────────────────
# КЛИЕНТ (попадает в браузерный бандл — только публичные значения)
# ─────────────────────────────────────────────────────────────

# Supabase: URL проекта и публикуемый ключ.
# Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Telegram Mini App: юзернейм бота и короткое имя приложения.
# Из них собирается ссылка-приглашение t.me/<bot>/<app>?startapp=CODE
# Наш бот — @MatchWatchApp_bot. Без «собачки»; другое имя ломает
# и вход, и ссылки-приглашения, и уведомления.
VITE_TELEGRAM_BOT_USERNAME=MatchWatchApp_bot
VITE_TELEGRAM_APP_NAME=app

# Трекинг ошибок фронтенда (Sentry или совместимый DSN). Пусто = выключено.
VITE_SENTRY_DSN=
VITE_RELEASE=dev

# ─────────────────────────────────────────────────────────────
# СЕРВЕР (только серверлес-функции в api/ — в браузер НЕ попадает)
# ─────────────────────────────────────────────────────────────

# TMDB. Достаточно одного из двух, v4-токен предпочтительнее.
# themoviedb.org -> Settings -> API -> API Read Access Token
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# Токен бота от @BotFather. Нужен для двух вещей сразу:
#   1) проверки подписи Telegram initData — без неё подделать чужой
#      telegram_id тривиально;
#   2) вывода учётных данных аккаунта из telegram_id.
# Без него вход через Telegram выключен, остальное работает.
#
# ВАЖНО: это должен быть токен ровно того бота, в котором открывается
# Mini App. Токен другого бота проходит все проверки формата, но подпись
# initData с ним не сойдётся никогда — пользователь увидит «Telegram
# не подтвердил вашу личность» и сделать ничего не сможет.
# Проверить, какой бот настроен: GET /api/auth/telegram — отдаёт botId
# и botUsername (публичные) без единого секрета.
TELEGRAM_BOT_TOKEN=

# ── Необязательное ниже ──────────────────────────────────────

# Секретный ключ Supabase. Вход и комнаты работают без него;
# нужен серверным задачам (кэш каталога, журнал телеметрии, метрики,
# крон уборки комнат) и привязке Telegram к существующему аккаунту.
#
# Без него вход через Telegram переходит в запасной режим: аккаунт
# выводится из telegram_id, и прицепить Telegram к email-аккаунту нельзя —
# некому связать telegram_id с чужим user_id.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Трекинг ошибок бэкенда — отдельный DSN, это другой источник сбоев.
SENTRY_DSN=

# Алерты при всплеске ошибок: Telegram-чат либо произвольный вебхук.
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
ALERT_ERROR_THRESHOLD=12

# Доступ к /api/ops/metrics и защита крон-эндпоинтов.
OPS_DASHBOARD_TOKEN=
CRON_SECRET=

# dev | staging | prod. Разделяет журналы и алерты по окружениям.
MATCHWATCH_ENV=

# Разрешённые origin для CORS (через запятую). Пусто = только свои домены.
ALLOWED_ORIGINS=

# ─── Разбор запроса «чего хочется сегодня» и объяснение выбора ───
# Ключ из Google AI Studio. Без него поле свободного текста скрыто,
# а шесть кнопок настроения работают как раньше.
GEMINI_API_KEY=
# Имя модели вынесено сюда, чтобы менять её без переката кода.
# Список доступных именно вашему ключу отдаёт GET /api/ai/models.
GEMINI_MODEL=gemini-3.5-flash
# Модель для коротких задач — объяснения выбора. Оно нажимается кнопкой,
# и ждать его столько же, сколько разбор запроса, человек не станет.
# Замер: /api/ai/bench?models=имя1,имя2 (закрыт CRON_SECRET).
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
